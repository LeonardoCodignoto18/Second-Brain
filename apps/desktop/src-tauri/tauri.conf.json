{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Brain OS",
  "version": "0.1.0",
  "identifier": "com.secondbrain.os",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src \u0027self\u0027; img-src \u0027self\u0027 asset:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Second Brain OS",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": []
  }
}
